# Dev API base. Omit this to auto-use http://<same-host-as-the-app>:4000/api (good for phone-on-LAN).
# Must be http:// in local dev — https:// will not match Vite/backend (plain HTTP) and causes ERR_SSL_PROTOCOL_ERROR.
VITE_API_BASE_URL=http://localhost:4000/api

# Optional: public web app origin (backend PLATFORM_URL). Defaults to window.location.origin.
# Set when previewing the SPA from a host/port that differs from where users open production.
# VITE_PLATFORM_URL=http://localhost:5173
