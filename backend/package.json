{
  "name": "qrpay-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run prisma:migrate:deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/check-prisma-migrations.mjs && prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:product-barcode": "tsx prisma/seed-product-barcode-entitlement.ts",
    "prisma:seed:default-chart-of-accounts": "tsx prisma/seed-default-chart-of-accounts.ts",
    "check:migrations": "node scripts/check-prisma-migrations.mjs",
    "test": "tsx --test src/services/wave-merchant-tx-summary.test.ts src/services/business-gateway-credential-wave.test.ts src/services/wave-self-settlement.util.test.ts src/services/wave-ops-transactions.util.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "resend": "^6.9.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
