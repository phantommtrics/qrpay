DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qrpay?schema=public"
PORT=4000

# Strong random secret for signing JWTs (required — cannot be empty; never commit real values)
# Example: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Token lifetime, e.g. 24h, 7d, 3600 (see jsonwebtoken expiresIn)
JWT_EXPIRES_IN=30d

# 32-byte AES key for encrypting per-business gateway secrets (base64).
# Also encrypts APS Wallet per-customer authorized_token rows (BusinessApsWalletCustomerAuth) after OTP confirm.
# Generate one of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
# APP_SECRET_ENCRYPTION_KEY=

# Comma-separated list of allowed browser origins (your real app URLs live only in .env, not in source)
CORS_ORIGINS=http://localhost:5173

# Public URL of the web app (required). Used for subscription emails, sales quotation/invoice guest links,
# /pay/:token return URLs, and wallet checkout success redirects (unless APP_PUBLIC_BASE_URL overrides API host).
PLATFORM_URL=http://localhost:5173
# Optional: require X-Simulator-Secret on POST /api/webhooks/payments/simulator
SIMULATOR_WEBHOOK_SECRET=
# Set true to allow POST /api/public/pay/:token/simulate in production (default: allowed in non-production)
SIMULATOR_ALLOW_PUBLIC_PAY=

RESEND_API_KEY=
RESEND_FROM_EMAIL="EasyPay <info@easy-pay.com>"

# Comma-separated — internal alert when someone registers a Corporate industry business (assign template in Platform → Corporate → Businesses)
CORPORATE_SIGNUP_NOTIFY_EMAIL=owner@phantommetrics.gm

# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=
# PLATFORM_OWNER_NAME=Platform Owner

# Wave / Yonna API hosts (shared for whole server; do not store per business)
WAVE_API_BASE_URL=https://api.wave.com

# Platform subscription checkout (Wave) — POST webhook uses WAVE_WEBHOOK_SECRET
# WAVE_CHECKOUT_BEARER=
# WAVE_WEBHOOK_SECRET=
# Public HTTPS origin of this API (no trailing slash). Used to build provider webhook URLs:
# {APP_PUBLIC_BASE_URL}/api/webhooks/wave and .../yonna-forex. Also used for checkout return URLs when set.
# APP_PUBLIC_BASE_URL=https://api.yourdomain.com

# Yonna Forex API base URL (required for Yonna checkout flows on this server)
# YONNA_FOREX_API_URL=https://example-yonna-api.example.com
# YONNA_FOREX_SECRET_KEY=
# YONNA_FOREX_CLIENT_ID=
# Optional: defaults to +220 if unset
# YONNA_FOREX_COUNTRY_CODE=+220
# Optional: when set, webhook requests must include X-Yonna-Signature: sha256=<hmac>
# YONNA_FOREX_WEBHOOK_SECRET=

# APS Money Wallet — server-wide API host and login channel. Paths are fixed in code (/api/v1/login, …).
# UAT example:
# APS_WALLET_BASE_URL=https://uat-wallet.apsmoney.gm
# Optional; sent as access_channel on POST /api/v1/login (same for all merchants on this deployment).
# APS_WALLET_ACCESS_CHANNEL=AGENT APP
# Platform subscription invoice APS checkout only — merchant login (same JSON shape as business: username + password).
# Businesses store their own encrypted username/password under Merchant API; POS/order APS does not use these.
# APS_WALLET_MOBILE=
# APS_WALLET_PASSWORD=
# If curl on Windows fails with schannel/TLS (SEC_E_ILLEGAL_MESSAGE), the PC may not complete HTTPS to APS.
# Try Git Bash/WSL curl, another network/VPN, or confirm with APS. The API server (Node) must reach APS_WALLET_BASE_URL too.
# Optional: JSON merged into the second authorize-customer call when APS returns "Account already linked" (repeat customer OTP).
# Default server behavior is to retry once with reauthorize: true; add e.g. resend_otp if APS documents it.
# APS_WALLET_AUTH_CUSTOMER_ALREADY_LINKED_MERGE_JSON={"reauthorize":true,"resend_otp":true}

# Simulated subscription invoice pay (POST /api/businesses/:id/invoices/:id/pay without Wave).
# In NODE_ENV=production, set to false to hide the button in the Billing page.
# ALLOW_DEV_SUBSCRIPTION_INVOICE_PAY=

# Platform subscription checkout — wallet/processor fee as a fraction of gross invoice (0–1).
# Recorded as billing WALLET_FEE + platform GL when payment succeeds. Examples: 0.01 = 1%, 0 = none.
SUBSCRIPTION_CHECKOUT_WAVE_WALLET_FEE_RATE=0.01
SUBSCRIPTION_CHECKOUT_YONNA_WALLET_FEE_RATE=0
SUBSCRIPTION_CHECKOUT_APS_WALLET_FEE_RATE=0
