DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qrpay?schema=public"
PORT=4000

FRONTEND_URL="http://localhost:5173"
# QR pay links in POS use this host (override if different from FRONTEND_URL)
PUBLIC_WEB_APP_URL="http://localhost:5173"
# Optional: require X-Simulator-Secret on POST /api/webhooks/payments/simulator
SIMULATOR_WEBHOOK_SECRET=
# Set true to allow POST /api/public/pay/:token/simulate in production (default: allowed in non-production)
SIMULATOR_ALLOW_PUBLIC_PAY=

RESEND_API_KEY=
RESEND_FROM_EMAIL="EasyPay <info@easy-pay.com>"
PLATFORM_URL="http://localhost:5173"

