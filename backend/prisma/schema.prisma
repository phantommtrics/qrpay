generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  BASIC
  PRO
  BUSINESS_PRO
}

enum UserRole {
  PLATFORM_OWNER
  /** Delegated platform operator; permissions come from PlatformFunctionGroup + role templates. */
  PLATFORM_ADMIN
  ADMIN
  MERCHANT
  CASHIER
  CUSTOMER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

/** Admin-only workflow: no money movement in-app; tracks external refund decisions. */
enum ManualRefundReviewStatus {
  NONE
  PENDING_REVIEW
  APPROVED_FOR_REFUND
  DECLINED
  REFUNDED_EXTERNALLY
}

enum BillingLedgerEntryType {
  INVOICE_PAYMENT
  REFUND
  ADJUSTMENT
}

enum BillingLedgerDirection {
  MONEY_IN
  MONEY_OUT
}

enum BillingLedgerStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum StaffCreationNotificationType {
  EXISTING_USER
  NEW_USER
  OWNER_SIGNUP
  /** Platform staff invite email (no business context; businessId on log is null). */
  PLATFORM_ADMIN_INVITE
  /** Subscription invoice issued to business owner (PDF attached). */
  SUBSCRIPTION_INVOICE
  /** Business notified that a subscription invoice refund is under platform review (PDF attached). */
  SUBSCRIPTION_INVOICE_REFUND_REVIEW
  /** Business notified that a refund was approved; includes expected refund date (PDF attached). */
  SUBSCRIPTION_INVOICE_REFUND_APPROVED
}

enum StaffCreationNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  QR_WALLET
  CASH
}

enum PaymentProvider {
  SIMULATOR
  WAVE_GAMBIA
  YONNA_WALLET
  /// Counter / POS cash recorded by staff (not a wallet simulator).
  UPFRONT_PAY
}

enum ChartAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalSourceType {
  CUSTOMER_SALE_PAYMENT
}

enum SalesLedgerEntryType {
  CUSTOMER_SALE
}

enum SalesLedgerDirection {
  MONEY_IN
}

enum SalesLedgerStatus {
  SUCCEEDED
}

enum BusinessMembershipStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  TERMINATED
}

model Business {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  industry                      String?
  ownerName                     String
  ownerEmail                    String
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  memberships                   BusinessMembership[]
  subscriptions                 Subscription[]
  invoices                      SubscriptionInvoice[]
  staffCreationNotificationLogs StaffCreationNotificationLog[]
  products                      Product[]
  menuCategories                MenuCategory[]
  diningTables                  DiningTable[]
  userSystemProducts            BusinessUserSystemProduct[]
  orders                        Order[]
  payments                      Payment[]
  receipts                      Receipt[]
  paymentMethods                BusinessPaymentMethod[]
  billingLedgerEntries          BillingLedgerEntry[]
  chartOfAccounts               ChartOfAccount[]
  journalEntries                JournalEntry[]
  salesLedgerEntries            SalesLedgerEntry[]
  gatewayCredentials            BusinessGatewayCredential[]
}

enum BusinessPaymentMethodStatus {
  ACTIVE
  ARCHIVED
}

/** Platform-configured payment providers businesses may attach as payment methods. */
model PaymentGateway {
  id          String                 @id @default(cuid())
  code        String                 @unique
  name        String
  description String?
  isEnabled   Boolean                @default(false)
  sortOrder   Int                    @default(0)
  /** When set (e.g. wave_gambia, yonna_wallet), subscription checkout can open a hosted payment flow. */
  checkoutAdapter String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  methods     BusinessPaymentMethod[]
  credentials BusinessGatewayCredential[]
}

model BusinessPaymentMethod {
  id          String                      @id @default(cuid())
  businessId  String
  gatewayId   String
  label       String
  metadata    Json?
  isDefault   Boolean                     @default(false)
  status      BusinessPaymentMethodStatus @default(ACTIVE)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gateway     PaymentGateway              @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([gatewayId])
}

/** Per-tenant API secrets for checkout adapters (ciphertext; decrypted only server-side). */
model BusinessGatewayCredential {
  id          String         @id @default(cuid())
  businessId  String
  gatewayId   String
  keyVersion  Int            @default(1)
  iv          String
  ciphertext  String         @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([businessId, gatewayId])
  @@index([businessId])
}

model ChartOfAccount {
  id         String               @id @default(cuid())
  businessId String
  code       String
  name       String
  category   ChartAccountCategory
  isSystem   Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines      JournalLine[]

  @@unique([businessId, code])
  @@index([businessId])
}

model JournalEntry {
  id          String             @id @default(cuid())
  businessId  String
  postedAt    DateTime           @default(now())
  memo        String?
  sourceType  JournalSourceType?
  /** e.g. Payment.id when sourceType is CUSTOMER_SALE_PAYMENT */
  sourceId    String?
  createdAt   DateTime           @default(now())
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines       JournalLine[]
  salesLedger SalesLedgerEntry[]

  @@index([businessId, postedAt])
  @@index([businessId, sourceType, sourceId])
}

model JournalLine {
  id               String         @id @default(cuid())
  journalEntryId   String
  chartOfAccountId String
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  journalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([chartOfAccountId])
}

model SalesLedgerEntry {
  id                   String               @id @default(cuid())
  businessId           String
  orderId              String?
  paymentId            String?              @unique
  journalEntryId       String
  type                 SalesLedgerEntryType
  direction            SalesLedgerDirection
  status               SalesLedgerStatus    @default(SUCCEEDED)
  amount               Decimal              @db.Decimal(12, 2)
  currency             String               @default("GMD")
  provider             String
  providerPaymentRef   String?
  metadata             Json?
  succeededAt          DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalEntry         JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  order                Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment              Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([orderId])
}

model MenuCategory {
  id         String          @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     MenuCategory?   @relation("MenuCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   MenuCategory[]  @relation("MenuCategoryHierarchy")
  products   Product[]

  @@index([businessId, parentId])
}

model DiningTable {
  id          String   @id @default(cuid())
  businessId  String
  label       String
  publicToken String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([businessId, publicToken])
  @@index([businessId])
}

model Product {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  category     String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  /** Physical units on hand (not yet sold). */
  stock        Int           @default(0)
  /** Units held for unpaid orders; released on cancel or applied on payment. */
  reservedStock Int          @default(0)
  barcodeType  String        @default("CODE128")
  barcodeValue String
  qrUrl        String
  imageUrl     String?
  imageColor   String        @default("bg-slate-100")
  imageEmoji   String        @default("")
  menuCategoryId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuCategory MenuCategory? @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  orderLines   OrderLine[]

  @@unique([businessId, barcodeValue])
  @@unique([businessId, qrUrl])
  @@index([businessId])
  @@index([menuCategoryId])
}

model User {
  id                            String                         @id @default(cuid())
  name                          String
  email                         String                         @unique
  passwordHash                  String
  role                          UserRole                       @default(MERCHANT)
  isActive                      Boolean                        @default(true)
  mustChangePassword            Boolean                        @default(false)
  passwordResetIssuedAt         DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  platformFunctionGroupId       String?
  memberships                   BusinessMembership[]
  staffCreationNotificationLogs StaffCreationNotificationLog[]
  businessSystemProducts        BusinessUserSystemProduct[]
  ordersCreated                 Order[]                        @relation("OrderCreatedBy")
  subscriptionInvoicesRefundReviewed SubscriptionInvoice[]     @relation("SubscriptionInvoiceRefundReviewedBy")
  platformFunctionGroup         PlatformFunctionGroup?         @relation(fields: [platformFunctionGroupId], references: [id], onDelete: SetNull)

  @@index([platformFunctionGroupId])
}

/** Sidebar / platform feature identifiers for RBAC templates (seeded). */
model PlatformModule {
  id           String                           @id @default(cuid())
  slug         String                           @unique
  label        String
  sortOrder    Int                              @default(0)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  templateRows PlatformRoleTemplatePermission[]
}

/** Named permission matrix (one row per module: view/create/edit/delete/export). */
model PlatformRoleTemplate {
  id            String                           @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  permissions   PlatformRoleTemplatePermission[]
  functionGroups PlatformFunctionGroup[]
}

model PlatformRoleTemplatePermission {
  id         String               @id @default(cuid())
  templateId String
  moduleId   String
  canView    Boolean              @default(false)
  canCreate  Boolean              @default(false)
  canEdit    Boolean              @default(false)
  canDelete  Boolean              @default(false)
  canExport  Boolean              @default(false)
  template   PlatformRoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  module     PlatformModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([templateId, moduleId])
  @@index([moduleId])
}

/** Bundles a role template; assigned to platform staff users. */
model PlatformFunctionGroup {
  id             String               @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  roleTemplateId String
  roleTemplate   PlatformRoleTemplate @relation(fields: [roleTemplateId], references: [id])
  users          User[]

  @@index([roleTemplateId])
}

model BusinessMembership {
  id         String                    @id @default(cuid())
  userId     String
  businessId String
  isOwner    Boolean                   @default(false)
  status     BusinessMembershipStatus  @default(ACTIVE)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  user       User                      @relation(fields: [userId], references: [id])
  business   Business                  @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([businessId, status])
}

model SystemService {
  id          String          @id @default(cuid())
  name        String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    SystemProduct[]
}

model SystemProduct {
  id          String              @id @default(cuid())
  serviceId   String
  name        String
  slug        String              @unique
  description String?
  sortOrder   Int                 @default(0)
  /** When set, product appears in the business sidebar under its service (must match app route path). */
  navPath     String?
  navLabel    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  service     SystemService       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  planLinks   PlanSystemProduct[]
  userGrants  BusinessUserSystemProduct[]

  @@index([serviceId])
}

/** Per-user assigned system products. Non-owners with no rows have no plan features until the owner assigns products. */
model BusinessUserSystemProduct {
  id              String        @id @default(cuid())
  businessId      String
  userId          String
  systemProductId String
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemProduct   SystemProduct @relation(fields: [systemProductId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, systemProductId])
  @@index([businessId, userId])
}

model PlanSystemProduct {
  id              String        @id @default(cuid())
  planId          String
  systemProductId String
  createdAt       DateTime      @default(now())
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  systemProduct   SystemProduct @relation(fields: [systemProductId], references: [id], onDelete: Cascade)

  @@unique([planId, systemProductId])
  @@index([planId])
  @@index([systemProductId])
}

model Plan {
  id                 String                @id @default(cuid())
  code               PlanCode              @unique
  name               String
  monthlyPrice       Decimal               @db.Decimal(10, 2)
  yearlyPrice        Decimal               @db.Decimal(10, 2)
  currency           String                @default("GMD")
  description        String
  staffLimit         Int
  outletLimit        Int
  productLimit       Int
  featureFlags       Json
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  subscriptions      Subscription[]
  invoices           SubscriptionInvoice[]
  planSystemProducts PlanSystemProduct[]
}

model Subscription {
  id                  String                @id @default(cuid())
  businessId          String
  planId              String
  billingInterval     BillingInterval       @default(MONTHLY)
  status              SubscriptionStatus    @default(ACTIVE)
  startDate           DateTime
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean               @default(false)
  cancelledAt         DateTime?
  endedAt             DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  business            Business              @relation(fields: [businessId], references: [id])
  plan                Plan                  @relation(fields: [planId], references: [id])
  invoices            SubscriptionInvoice[]
  billingLedgerEntries BillingLedgerEntry[]

  @@index([businessId, status])
  @@index([planId])
}

model SubscriptionInvoice {
  id                  String             @id @default(cuid())
  businessId          String
  subscriptionId      String
  planId              String
  amount              Decimal            @db.Decimal(10, 2)
  currency            String             @default("GMD")
  status              InvoiceStatus      @default(PENDING)
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  dueDate             DateTime
  paidAt              DateTime?
  externalReference   String?            @unique
  /** Last checkout session id (e.g. Wave) for webhook correlation. */
  checkoutSessionId   String?
  checkoutProvider    String?
  manualRefundReviewStatus     ManualRefundReviewStatus @default(NONE)
  manualRefundNote             String?
  manualRefundReviewedAt       DateTime?
  manualRefundReviewedByUserId String?
  /** Target date by which finance aims to complete the refund (set when status is APPROVED_FOR_REFUND). */
  manualRefundExpectedBy       DateTime?
  /** Approved refund amount when partial; null means full invoice amount. */
  manualRefundApprovedAmount   Decimal?           @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  business            Business           @relation(fields: [businessId], references: [id])
  subscription        Subscription       @relation(fields: [subscriptionId], references: [id])
  plan                Plan               @relation(fields: [planId], references: [id])
  manualRefundReviewedBy User?             @relation("SubscriptionInvoiceRefundReviewedBy", fields: [manualRefundReviewedByUserId], references: [id], onDelete: SetNull)
  ledgerEntries       BillingLedgerEntry[]

  @@index([businessId, status])
  @@index([subscriptionId])
  @@index([checkoutSessionId])
  @@index([manualRefundReviewStatus])
}

model BillingLedgerEntry {
  id                        String                  @id @default(cuid())
  businessId                String
  subscriptionId            String?
  subscriptionInvoiceId     String?
  type                      BillingLedgerEntryType
  direction                 BillingLedgerDirection
  status                    BillingLedgerStatus     @default(PENDING)
  amount                    Decimal                 @db.Decimal(10, 2)
  currency                  String                  @default("GMD")
  provider                  String
  providerCheckoutSessionId String?                 @unique
  providerPaymentRef        String?
  idempotencyKey            String?                 @unique
  metadata                  Json?
  succeededAt               DateTime?
  failedAt                  DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  business                  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription              Subscription?           @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionInvoice       SubscriptionInvoice?    @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([subscriptionInvoiceId])
  @@index([subscriptionId])
}

model StaffCreationNotificationLog {
  id               String                          @id @default(cuid())
  /** Null when the notification is platform-scoped (e.g. platform admin invite). */
  businessId       String?
  userId           String?
  recipientName    String
  recipientEmail   String
  staffRole        UserRole
  notificationType StaffCreationNotificationType
  deliveryStatus   StaffCreationNotificationStatus @default(PENDING)
  provider         String                          @default("resend")
  subject          String
  htmlBody         String?
  textBody         String?
  resendEmailId    String?
  failureReason    String?
  sentAt           DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  business         Business?                       @relation(fields: [businessId], references: [id])
  user             User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
  @@map("staffCreationNotificationLogs")
}

model Order {
  id                   String       @id @default(cuid())
  businessId           String
  publicCode           String
  status               OrderStatus  @default(PENDING_PAYMENT)
  subtotal             Decimal      @db.Decimal(10, 2)
  taxAmount            Decimal      @default(0) @db.Decimal(10, 2)
  total                Decimal      @db.Decimal(10, 2)
  currency             String       @default("GMD")
  createdByUserId      String?
  diningTableId        String?
  tableLabelSnapshot   String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  business             Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy            User?        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  diningTable          DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  lines                OrderLine[]
  payments             Payment[]
  receipt              Receipt?
  salesLedgerEntries   SalesLedgerEntry[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([diningTableId])
  @@unique([businessId, publicCode])
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id              String          @id @default(cuid())
  businessId      String
  orderId         String
  publicCode      String
  method          PaymentMethod
  provider        PaymentProvider @default(SIMULATOR)
  /** When set, identifies which business PaymentGateway credentials were used for QR wallet checkout. */
  gatewayCode     String?
  status          PaymentStatus   @default(PENDING)
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("GMD")
  providerRef     String          @unique
  publicToken     String          @unique
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesLedger     SalesLedgerEntry?

  @@index([orderId])
  @@index([businessId, status])
  @@index([publicToken])
  @@unique([businessId, publicCode])
}

model Receipt {
  id            String   @id @default(cuid())
  businessId     String
  orderId       String   @unique
  publicCode    String
  receiptNumber Int
  total         Decimal  @db.Decimal(10, 2)
  currency      String   @default("GMD")
  linesSnapshot Json
  paymentMethod String
  provider      String   @default("SIMULATOR")
  providerRef   String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptNumber])
  @@unique([businessId, publicCode])
}

model WebhookEventLog {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String
  createdAt   DateTime @default(now())

  @@unique([provider, eventKey])
}
