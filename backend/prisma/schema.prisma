generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  BASIC
  PRO
  BUSINESS_PRO
}

enum UserRole {
  PLATFORM_OWNER
  /** Delegated platform operator; permissions come from PlatformFunctionGroup + role templates. */
  PLATFORM_ADMIN
  ADMIN
  MERCHANT
  CASHIER
  CUSTOMER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

enum StaffCreationNotificationType {
  EXISTING_USER
  NEW_USER
  OWNER_SIGNUP
  /** Platform staff invite email (no business context; businessId on log is null). */
  PLATFORM_ADMIN_INVITE
}

enum StaffCreationNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  QR_WALLET
  CASH
}

enum PaymentProvider {
  SIMULATOR
}

enum BusinessMembershipStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  TERMINATED
}

model Business {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  industry                      String?
  ownerName                     String
  ownerEmail                    String
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  memberships                   BusinessMembership[]
  subscriptions                 Subscription[]
  invoices                      SubscriptionInvoice[]
  staffCreationNotificationLogs StaffCreationNotificationLog[]
  products                      Product[]
  userSystemProducts            BusinessUserSystemProduct[]
  orders                        Order[]
  payments                      Payment[]
  receipts                      Receipt[]
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  category     String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  stock        Int      @default(0)
  barcodeType  String   @default("CODE128")
  barcodeValue String
  qrUrl        String
  imageUrl     String?
  imageColor   String   @default("bg-slate-100")
  imageEmoji   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderLines   OrderLine[]

  @@unique([businessId, barcodeValue])
  @@unique([businessId, qrUrl])
  @@index([businessId])
}

model User {
  id                            String                         @id @default(cuid())
  name                          String
  email                         String                         @unique
  passwordHash                  String
  role                          UserRole                       @default(MERCHANT)
  isActive                      Boolean                        @default(true)
  mustChangePassword            Boolean                        @default(false)
  passwordResetIssuedAt         DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  platformFunctionGroupId       String?
  memberships                   BusinessMembership[]
  staffCreationNotificationLogs StaffCreationNotificationLog[]
  businessSystemProducts        BusinessUserSystemProduct[]
  ordersCreated                 Order[]                        @relation("OrderCreatedBy")
  platformFunctionGroup         PlatformFunctionGroup?         @relation(fields: [platformFunctionGroupId], references: [id], onDelete: SetNull)

  @@index([platformFunctionGroupId])
}

/** Sidebar / platform feature identifiers for RBAC templates (seeded). */
model PlatformModule {
  id           String                           @id @default(cuid())
  slug         String                           @unique
  label        String
  sortOrder    Int                              @default(0)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  templateRows PlatformRoleTemplatePermission[]
}

/** Named permission matrix (one row per module: view/create/edit/delete/export). */
model PlatformRoleTemplate {
  id            String                           @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  permissions   PlatformRoleTemplatePermission[]
  functionGroups PlatformFunctionGroup[]
}

model PlatformRoleTemplatePermission {
  id         String               @id @default(cuid())
  templateId String
  moduleId   String
  canView    Boolean              @default(false)
  canCreate  Boolean              @default(false)
  canEdit    Boolean              @default(false)
  canDelete  Boolean              @default(false)
  canExport  Boolean              @default(false)
  template   PlatformRoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  module     PlatformModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([templateId, moduleId])
  @@index([moduleId])
}

/** Bundles one or more role templates; assigned to platform staff users. */
model PlatformFunctionGroup {
  id            String                 @id @default(cuid())
  name          String
  description   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  roleTemplates PlatformRoleTemplate[]
  users         User[]
}

model BusinessMembership {
  id         String                    @id @default(cuid())
  userId     String
  businessId String
  isOwner    Boolean                   @default(false)
  status     BusinessMembershipStatus  @default(ACTIVE)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  user       User                      @relation(fields: [userId], references: [id])
  business   Business                  @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([businessId, status])
}

model SystemService {
  id          String          @id @default(cuid())
  name        String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    SystemProduct[]
}

model SystemProduct {
  id          String              @id @default(cuid())
  serviceId   String
  name        String
  slug        String              @unique
  description String?
  sortOrder   Int                 @default(0)
  /** When set, product appears in the business sidebar under its service (must match app route path). */
  navPath     String?
  navLabel    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  service     SystemService       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  planLinks   PlanSystemProduct[]
  userGrants  BusinessUserSystemProduct[]

  @@index([serviceId])
}

/** Per-user assigned system products. Non-owners with no rows have no plan features until the owner assigns products. */
model BusinessUserSystemProduct {
  id              String        @id @default(cuid())
  businessId      String
  userId          String
  systemProductId String
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemProduct   SystemProduct @relation(fields: [systemProductId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, systemProductId])
  @@index([businessId, userId])
}

model PlanSystemProduct {
  id              String        @id @default(cuid())
  planId          String
  systemProductId String
  createdAt       DateTime      @default(now())
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  systemProduct   SystemProduct @relation(fields: [systemProductId], references: [id], onDelete: Cascade)

  @@unique([planId, systemProductId])
  @@index([planId])
  @@index([systemProductId])
}

model Plan {
  id                 String                @id @default(cuid())
  code               PlanCode              @unique
  name               String
  monthlyPrice       Decimal               @db.Decimal(10, 2)
  currency           String                @default("GMD")
  description        String
  staffLimit         Int
  outletLimit        Int
  productLimit       Int
  featureFlags       Json
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  subscriptions      Subscription[]
  invoices           SubscriptionInvoice[]
  planSystemProducts PlanSystemProduct[]
}

model Subscription {
  id                  String                @id @default(cuid())
  businessId          String
  planId              String
  status              SubscriptionStatus    @default(ACTIVE)
  startDate           DateTime
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean               @default(false)
  cancelledAt         DateTime?
  endedAt             DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  business            Business              @relation(fields: [businessId], references: [id])
  plan                Plan                  @relation(fields: [planId], references: [id])
  invoices            SubscriptionInvoice[]

  @@index([businessId, status])
  @@index([planId])
}

model SubscriptionInvoice {
  id                  String             @id @default(cuid())
  businessId          String
  subscriptionId      String
  planId              String
  amount              Decimal            @db.Decimal(10, 2)
  currency            String             @default("GMD")
  status              InvoiceStatus      @default(PENDING)
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  dueDate             DateTime
  paidAt              DateTime?
  externalReference   String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  business            Business           @relation(fields: [businessId], references: [id])
  subscription        Subscription       @relation(fields: [subscriptionId], references: [id])
  plan                Plan               @relation(fields: [planId], references: [id])

  @@index([businessId, status])
  @@index([subscriptionId])
}

model StaffCreationNotificationLog {
  id               String                          @id @default(cuid())
  /** Null when the notification is platform-scoped (e.g. platform admin invite). */
  businessId       String?
  userId           String?
  recipientName    String
  recipientEmail   String
  staffRole        UserRole
  notificationType StaffCreationNotificationType
  deliveryStatus   StaffCreationNotificationStatus @default(PENDING)
  provider         String                          @default("resend")
  subject          String
  htmlBody         String?
  textBody         String?
  resendEmailId    String?
  failureReason    String?
  sentAt           DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  business         Business?                       @relation(fields: [businessId], references: [id])
  user             User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
  @@map("staffCreationNotificationLogs")
}

model Order {
  id              String      @id @default(cuid())
  businessId      String
  publicCode      String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("GMD")
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User?       @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines           OrderLine[]
  payments        Payment[]
  receipt         Receipt?

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@unique([businessId, publicCode])
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id              String          @id @default(cuid())
  businessId      String
  orderId         String
  publicCode      String
  method          PaymentMethod
  provider        PaymentProvider @default(SIMULATOR)
  status          PaymentStatus   @default(PENDING)
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("GMD")
  providerRef     String          @unique
  publicToken     String          @unique
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([businessId, status])
  @@index([publicToken])
  @@unique([businessId, publicCode])
}

model Receipt {
  id            String   @id @default(cuid())
  businessId     String
  orderId       String   @unique
  publicCode    String
  receiptNumber Int
  total         Decimal  @db.Decimal(10, 2)
  currency      String   @default("GMD")
  linesSnapshot Json
  paymentMethod String
  provider      String   @default("SIMULATOR")
  providerRef   String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptNumber])
  @@unique([businessId, publicCode])
}

model WebhookEventLog {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String
  createdAt   DateTime @default(now())

  @@unique([provider, eventKey])
}
