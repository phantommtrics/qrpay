generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  BASIC
  PRO
  BUSINESS_PRO
  /** Same breadth as Business Pro minus POS, products, orders, and categories — used for Corporate industry. */
  CORPORATE
}

enum UserRole {
  PLATFORM_OWNER
  /**
   * Delegated platform operator; permissions come from PlatformFunctionGroup + role templates.
   */
  PLATFORM_ADMIN
  ADMIN
  MERCHANT
  CASHIER
  CUSTOMER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

/**
 * Admin-only workflow: no money movement in-app; tracks external refund decisions.
 */
enum ManualRefundReviewStatus {
  NONE
  PENDING_REVIEW
  APPROVED_FOR_REFUND
  DECLINED
  REFUNDED_EXTERNALLY
}

enum BillingLedgerEntryType {
  INVOICE_PAYMENT
  REFUND
  ADJUSTMENT
  /**
   * Platform-paid wallet rail fee (e.g. Wave) on successful subscription checkout.
   */
  WALLET_FEE
}

enum BillingLedgerDirection {
  MONEY_IN
  MONEY_OUT
}

enum BillingLedgerStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  TWO_YEARS
  /** Signed contract: one payment, no automatic renewal (perpetual access while active). */
  CONTRACT_INFINITE
}

enum StaffCreationNotificationType {
  EXISTING_USER
  NEW_USER
  OWNER_SIGNUP
  /**
   * Platform staff invite email (no business context; businessId on log is null).
   */
  PLATFORM_ADMIN_INVITE
  /**
   * Subscription invoice issued to business owner (PDF attached).
   */
  SUBSCRIPTION_INVOICE
  /**
   * Merchant-issued sales invoice approved / sent to customer contact.
   */
  SALES_INVOICE_APPROVED
  /**
   * Purchase bill approved / sent to supplier contact (PDF attached).
   */
  PURCHASE_BILL_APPROVED
  /**
   * Sales quotation sent to customer contact (PDF + guest link).
   */
  SALES_QUOTATION_SENT
  /**
   * Business notified that a subscription invoice refund is under platform review (PDF attached).
   */
  SUBSCRIPTION_INVOICE_REFUND_REVIEW
  /**
   * Business notified that a refund was approved; includes expected refund date (PDF attached).
   */
  SUBSCRIPTION_INVOICE_REFUND_APPROVED
  /**
   * Business owner reminded that the current subscription period ends in about one week.
   */
  SUBSCRIPTION_ENDING_REMINDER
}

enum StaffCreationNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  QR_WALLET
  CASH
}

enum PaymentProvider {
  SIMULATOR
  WAVE_GAMBIA
  YONNA_WALLET
  /// Platform APS Money Wallet (merchant env + OTP on customer phone).
  APS_WALLET
  /// Counter / POS cash recorded by staff (not a wallet simulator).
  UPFRONT_PAY
}

enum ChartAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/**
 * General ledger line vs operating bank account record on the chart.
 */
enum ChartAccountKind {
  LEDGER
  BANK
}

enum JournalSourceType {
  CUSTOMER_SALE_PAYMENT
  /**
   * Merchant wallet/processor fee on a completed customer QR payment (pairs with SalesLedger WALLET_FEE).
   */
  CUSTOMER_SALE_WALLET_FEE
  MANUAL_MONEY_IN
  MANUAL_MONEY_OUT
  MANUAL_BANK_TRANSFER
  /**
   * Cash-basis GL when a business sales invoice is marked paid.
   */
  SALES_INVOICE_PAYMENT
  /**
   * Cash-basis GL when a purchase bill is marked paid (money out).
   */
  PURCHASE_BILL_PAYMENT
  /**
   * Balanced debit/credit lines only; no settlement asset leg.
   */
  MANUAL_GENERAL_JOURNAL
  /**
   * Opposite debits/credits to undo a prior journal (audit trail).
   */
  MANUAL_JOURNAL_REVERSAL
}

/**
 * Easypay operator GL — merchant subscription cash vs manual platform costs.
 */
enum PlatformJournalSourceType {
  MANUAL
  /**
   * Swapped debits/credits to undo a prior manual (or reversal) entry.
   */
  MANUAL_JOURNAL_REVERSAL
  /**
   * Cash-basis AP when a platform purchase bill is marked paid.
   */
  PURCHASE_BILL_PAYMENT
  SUBSCRIPTION_INVOICE_PAYMENT
  /**
   * Checkout started: receivable vs deferred revenue until payment succeeds.
   */
  SUBSCRIPTION_CHECKOUT_PENDING
  /**
   * Payment captured: clear receivable, recognize revenue (pairs with pending).
   */
  SUBSCRIPTION_CHECKOUT_SETTLEMENT
  /**
   * Refund paid to merchant (billing ledger REFUND row).
   */
  SUBSCRIPTION_REFUND
  /**
   * Wallet/processor fee on subscription payment (billing ledger WALLET_FEE row).
   */
  SUBSCRIPTION_WALLET_FEE
  /**
   * Aggregator self-settlement: payout cost + withhold revenue for a merchant checkout.
   */
  WAVE_SELF_SETTLEMENT
}

enum SalesLedgerEntryType {
  CUSTOMER_SALE
  WALLET_FEE
}

enum SalesLedgerDirection {
  MONEY_IN
  MONEY_OUT
}

enum SalesLedgerStatus {
  SUCCEEDED
}

/**
 * Local copy of a DigitalOcean customer invoice (finalized months only; preview is never stored).
 */
enum DigitalOceanInvoiceStatus {
  SYNCED
  POSTED
}

/**
 * Audit log: who performed an action (staff user vs automated system).
 */
enum ActivityActorKind {
  USER
  SYSTEM
}

enum BusinessMembershipStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  TERMINATED
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesInvoiceStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

/**
 * Admin-defined subscription price templates for Corporate industry businesses.
 * Assigned per business with monthly or yearly billing.
 */
model CorporateBillingPlan {
  id             String     @id @default(cuid())
  name           String
  monthlyPrice   Decimal    @db.Decimal(10, 2)
  quarterlyPrice Decimal    @default(0) @db.Decimal(10, 2)
  halfYearlyPrice Decimal   @default(0) @db.Decimal(10, 2)
  yearlyPrice    Decimal    @db.Decimal(10, 2)
  twoYearPrice   Decimal    @default(0) @db.Decimal(10, 2)
  /// One-time fee for CONTRACT_INFINITE (signed contract / perpetual).
  contractPrice  Decimal    @default(0) @db.Decimal(10, 2)
  currency       String     @default("GMD")
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  businesses     Business[]
}

model Business {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  industry                      String?
  ownerName                     String
  ownerEmail                    String
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  /**
   * When true, this tenant is comped (no platform subscription invoices). Used for internal partner apps.
   */
  platformBillingWaived         Boolean                        @default(false)
  /**
   * Stable id from the connecting app (e.g. 7-aside user id). Unique when set.
   */
  partnerProvisioningExternalUserId String?                  @unique
  /**
   * Optional override for outbound payment-status webhooks; defaults to comma-separated INTERNAL_PARTNER_WEBHOOK_URL targets.
   */
  internalPartnerWebhookUrl     String?
  /// When set with corporate billing interval, subscription invoices use this template instead of list-plan prices.
  corporateBillingPlanId        String?
  corporateBillingPlan          CorporateBillingPlan?          @relation(fields: [corporateBillingPlanId], references: [id], onDelete: SetNull)
  corporateBillingInterval      BillingInterval?
  /// Optional per-business entitlement override (system product ids). Empty = use plan defaults from the Corporate plan.
  corporateEntitlementSystemProductIds String[]              @default([])
  memberships                   BusinessMembership[]
  subscriptions                 Subscription[]
  invoices                      SubscriptionInvoice[]
  staffCreationNotificationLogs StaffCreationNotificationLog[]
  products                      Product[]
  menuCategories                MenuCategory[]
  diningTables                  DiningTable[]
  businessStations              BusinessStation[]
  userSystemProducts            BusinessUserSystemProduct[]
  pushSubscriptions             BusinessOwnerPushSubscription[]
  orders                        Order[]
  payments                      Payment[]
  receipts                      Receipt[]
  paymentMethods                BusinessPaymentMethod[]
  billingLedgerEntries          BillingLedgerEntry[]
  chartOfAccounts               ChartOfAccount[]
  contacts                      BusinessContact[]
  journalEntries                JournalEntry[]
  salesLedgerEntries            SalesLedgerEntry[]
  gatewayCredentials            BusinessGatewayCredential[]
  waveAggregatedMerchantProvisionLogs WaveAggregatedMerchantProvisionLog[]
  waveSelfSettlementPayouts     WaveSelfSettlementPayout[]
  waveOpsPayouts                WaveOpsPayout[]
  platformJournalEntries        PlatformJournalEntry[]
  apsWalletCustomerAuths        BusinessApsWalletCustomerAuth[]
  salesQuotations               SalesQuotation[]
  salesInvoices                 SalesInvoice[]
  bills                         Bill[]
  activityLogs                  ActivityLog[]
}

enum BusinessPaymentMethodStatus {
  ACTIVE
  ARCHIVED
}

/** Why a Wave aggregated merchant provision was attempted. */
enum WaveAggregatedMerchantProvisionTrigger {
  ORGANIZATION_CREATED
  PLATFORM_MANUAL
  INTERNAL_PARTNER_PROVISION
  API_CREATE_BUSINESS
}

enum WaveAggregatedMerchantProvisionOperation {
  CREATE
  UPDATE
}

enum WaveAggregatedMerchantProvisionStatus {
  SKIPPED
  SUCCEEDED
  FAILED
}

/** Outbound partner app webhooks (retry queue). */
enum PartnerOutboundWebhookJobStatus {
  PENDING
  SUCCEEDED
  ABANDONED
}

model PartnerOutboundWebhookJob {
  id             String                         @id @default(cuid())
  status         PartnerOutboundWebhookJobStatus @default(PENDING)
  attempts       Int                            @default(0)
  maxAttempts    Int                            @default(8)
  nextAttemptAt  DateTime                       @default(now())
  webhookUrl     String                         @db.Text
  /// Exact UTF-8 JSON string used for HMAC (must stay stable across retries).
  bodyText       String                         @db.Text
  lastHttpStatus Int?
  lastError      String?                        @db.Text
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([status, nextAttemptAt])
}

/**
 * Platform-admin configured outbound webhook destinations for internal partner integrations.
 * Replaces comma-separated INTERNAL_PARTNER_WEBHOOK_URL / *_SECRET env vars when rows exist.
 */
model PartnerWebhookEndpoint {
  id         String   @id @default(cuid())
  label      String?
  webhookUrl String   @unique @db.Text
  iv         String
  ciphertext String   @db.Text
  keyVersion Int      @default(1)
  isEnabled  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isEnabled, sortOrder])
}

/// Distinguishes APS authorized_token rows: business merchant (POS/orders) vs platform env (subscription invoices).
enum ApsWalletCustomerAuthMerchantScope {
  BUSINESS_MERCHANT
  PLATFORM_SUBSCRIPTION
}

/**
 * Platform-configured payment providers businesses may attach as payment methods.
 */
model PaymentGateway {
  id              String                      @id @default(cuid())
  code            String                      @unique
  name            String
  description     String?
  isEnabled       Boolean                     @default(false)
  sortOrder       Int                         @default(0)
  /**
   * When set (e.g. wave_gambia, yonna_wallet), subscription checkout can open a hosted payment flow.
   */
  checkoutAdapter String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  methods         BusinessPaymentMethod[]
  credentials     BusinessGatewayCredential[]
  apsWalletCustomerAuths BusinessApsWalletCustomerAuth[]
}

/**
 * APS Wallet: per-business encrypted authorized_token for a customer mobile after OTP confirm.
 * Used for subsequent process-payment calls without repeating authorize+OTP when still valid.
 * `merchantScope` separates tokens for the business APS merchant (sales) vs the platform APS merchant (subscription billing).
 */
model BusinessApsWalletCustomerAuth {
  id                       String                             @id @default(cuid())
  businessId               String
  gatewayId                String
  customerMobileNormalized String
  merchantScope            ApsWalletCustomerAuthMerchantScope @default(BUSINESS_MERCHANT)
  iv                       String
  ciphertext               String                             @db.Text
  keyVersion               Int                                @default(1)
  lastUnlinkAttemptAt      DateTime?
  lastUnlinkSucceededAt    DateTime?
  lastUnlinkError          String?                            @db.Text
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  business                 Business                           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gateway                  PaymentGateway                     @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([businessId, gatewayId, customerMobileNormalized, merchantScope])
  @@index([businessId])
}

model BusinessPaymentMethod {
  id         String                      @id @default(cuid())
  businessId String
  gatewayId  String
  label      String
  metadata   Json?
  isDefault  Boolean                     @default(false)
  status     BusinessPaymentMethodStatus @default(ACTIVE)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  business   Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gateway    PaymentGateway              @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([gatewayId])
}

/**
 * Per-tenant API secrets for checkout adapters (ciphertext; decrypted only server-side).
 */
model BusinessGatewayCredential {
  id         String         @id @default(cuid())
  businessId String
  gatewayId  String
  keyVersion Int            @default(1)
  iv         String
  ciphertext String         @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  gateway    PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([businessId, gatewayId])
  @@index([businessId])
}

/**
 * Audit log for Wave aggregated merchant create/update attempts (sales checkout only).
 */
model WaveAggregatedMerchantProvisionLog {
  id                   String                                  @id @default(cuid())
  businessId           String
  trigger              WaveAggregatedMerchantProvisionTrigger
  operation            WaveAggregatedMerchantProvisionOperation?
  status               WaveAggregatedMerchantProvisionStatus
  requestedName        String?
  requestPayload       Json?
  aggregatedMerchantId String?
  errorMessage         String?                                 @db.Text
  createdAt            DateTime                                @default(now())
  business             Business                                @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

enum WaveSelfSettlementPayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  SKIPPED
}

/**
 * Aggregator self-settlement: after a tenant Wave checkout webhook, payout gross minus withhold
 * to the merchant's configured Wave mobile, debiting their aggregated merchant id.
 */
model WaveSelfSettlementPayout {
  id                       String                         @id @default(cuid())
  paymentId                String                         @unique
  businessId               String
  aggregatedMerchantId     String
  mobile                   String
  name                     String
  currency                 String
  grossAmount              Decimal                        @db.Decimal(12, 2)
  withholdAmount           Decimal                        @db.Decimal(12, 2)
  requestedReceiveAmount   Decimal                        @db.Decimal(12, 2)
  receiveAmount            Decimal                        @db.Decimal(12, 2)
  clamped                  Boolean                        @default(false)
  fee                      String?
  status                   WaveSelfSettlementPayoutStatus @default(PENDING)
  wavePayoutId             String?                        @unique
  clientReference          String?
  idempotencyKey           String                         @unique
  attempts                 Int                            @default(0)
  maxAttempts              Int                            @default(8)
  nextAttemptAt            DateTime                       @default(now())
  errorCode                String?
  errorMessage             String?                        @db.Text
  skipReason               String?
  waveTimestamp            DateTime?
  platformJournalEntryId   String?                        @unique
  waveOpsPayoutId          String?                        @unique
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  payment                  Payment                        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  business                 Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformJournalEntry     PlatformJournalEntry?          @relation("WaveSelfSettlementJournal", fields: [platformJournalEntryId], references: [id], onDelete: SetNull)
  waveOpsPayout            WaveOpsPayout?                 @relation("WaveSelfSettlementOpsPayout", fields: [waveOpsPayoutId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
}

/**
 * Counterparties for manual journal entries (received from / paid to).
 */
model BusinessContact {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  email           String?
  phone           String?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalEntries  JournalEntry[]
  salesQuotations SalesQuotation[]
  salesInvoices   SalesInvoice[]
  bills           Bill[]

  @@index([businessId])
  @@index([businessId, name])
}

model ChartOfAccount {
  id                       String               @id @default(cuid())
  businessId               String
  code                     String
  name                     String
  /**
   * Guidance for bookkeepers: what transactions belong in this account.
   */
  description              String?              @db.Text
  category                 ChartAccountCategory
  kind                     ChartAccountKind     @default(LEDGER)
  /**
   * For kind BANK: number as shown on statements / IBAN tail.
   */
  bankAccountNumber        String?
  bankName                 String?
  /**
   * Branch, SWIFT, notes — optional.
   */
  bankDetails              String?              @db.Text
  isSystem                 Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  business                 Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines                    JournalLine[]
  salesQuotationLines      SalesQuotationLine[]
  salesInvoiceLines        SalesInvoiceLine[]
  billLines                BillLine[]
  salesInvoicesSettledHere SalesInvoice[]       @relation("InvoiceSettlementAccount")
  billsSettledHere         Bill[]               @relation("BillSettlementAccount")

  @@unique([businessId, code])
  @@index([businessId])
}

model JournalEntry {
  id                      String             @id @default(cuid())
  businessId              String
  postedAt                DateTime           @default(now())
  memo                    String?
  sourceType              JournalSourceType?
  /**
   * e.g. Payment.id when sourceType is CUSTOMER_SALE_PAYMENT
   */
  sourceId                String?
  /**
   * External reference (invoice no., cheque no., etc.).
   */
  reference               String?
  contactId               String?
  /**
   * When set, this entry is a reversal: it mirrors another entry with debits/credits swapped.
   * Each source journal can have at most one reversal row pointing to it.
   */
  reversesJournalEntryId  String?            @unique
  /**
   * Platform (or delegated) approval before the posting is included in GL / P&L / account statements.
   * Legacy rows are backfilled to postedAt; exempt postings (e.g. customer sale QR/POS) never require approval.
   */
  approvedAt              DateTime?
  approvedByUserId        String?
  journalApprovalExempt   Boolean            @default(false)
  /**
   * Pending posting removed from the approval pipeline; never included in GL / P&L / statements.
   */
  cancelledAt             DateTime?
  cancelledByUserId       String?
  createdAt               DateTime           @default(now())
  business                Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact                 BusinessContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  approvedBy              User?              @relation("JournalEntryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  cancelledBy             User?              @relation("JournalEntryCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  /**
   * Set when a platform owner/admin posts this entry for the business without a business membership (on behalf of the merchant).
   */
  postedByPlatformUserId  String?
  postedByPlatformUser    User?              @relation("JournalEntryPostedByPlatform", fields: [postedByPlatformUserId], references: [id], onDelete: SetNull)
  reversesJournalEntry    JournalEntry?      @relation("JournalReversal", fields: [reversesJournalEntryId], references: [id], onDelete: Restrict)
  reversedByEntry         JournalEntry?      @relation("JournalReversal")
  lines                   JournalLine[]
  salesLedger             SalesLedgerEntry[]
  salesInvoiceFromPayment SalesInvoice?      @relation("SalesInvoiceJournal")
  billFromPayment         Bill?              @relation("BillJournal")

  @@index([businessId, postedAt])
  @@index([businessId, sourceType, sourceId])
  @@index([contactId])
  @@index([approvedAt])
  @@index([cancelledAt])
  @@index([postedByPlatformUserId])
}

model JournalLine {
  id               String         @id @default(cuid())
  journalEntryId   String
  chartOfAccountId String
  debitAmount      Decimal        @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal        @default(0) @db.Decimal(12, 2)
  /**
   * Line narration for financial review (IFRS-style clarity).
   */
  description      String?        @db.Text
  quantity         Decimal?       @db.Decimal(18, 6)
  unitLabel        String?
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  journalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([chartOfAccountId])
}

/**
 * Customer quote (Xero-style); accepting creates a sales invoice draft.
 */
model SalesQuotation {
  id               String               @id @default(cuid())
  businessId       String
  contactId        String
  publicCode       String
  status           SalesQuotationStatus @default(DRAFT)
  validUntil       DateTime?
  reference        String?
  currency         String               @default("GMD")
  /**
   * Secret token for guest view / accept / reject (set when sent).
   */
  guestToken       String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact          BusinessContact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  lines            SalesQuotationLine[]
  invoiceFromQuote SalesInvoice?        @relation("QuotationToInvoice")

  @@unique([businessId, publicCode])
  @@index([businessId, status])
}

model SalesQuotationLine {
  id               String         @id @default(cuid())
  quotationId      String
  chartOfAccountId String
  narration        String         @default("")
  quantity         Decimal        @db.Decimal(18, 6)
  unitLabel        String?
  unitAmount       Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  sortOrder        Int            @default(0)
  quotation        SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([quotationId])
}

/**
 * Merchant-issued invoice. General ledger is posted only when status becomes PAID (cash-basis).
 * Approving notifies the contact by email (Xero-style issue / send).
 */
model SalesInvoice {
  id                       String             @id @default(cuid())
  businessId               String
  contactId                String
  sourceQuotationId        String?            @unique
  publicCode               String
  status                   SalesInvoiceStatus @default(DRAFT)
  issueDate                DateTime
  dueDate                  DateTime?
  reference                String?
  currency                 String             @default("GMD")
  /**
   * Secret token for guest view / wallet pay (set when approved).
   */
  guestToken               String?            @unique
  settlementChartAccountId String?
  journalEntryId           String?            @unique
  approvedAt               DateTime?
  paidAt                   DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  business                 Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact                  BusinessContact    @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sourceQuotation          SalesQuotation?    @relation("QuotationToInvoice", fields: [sourceQuotationId], references: [id], onDelete: SetNull)
  settlementAccount        ChartOfAccount?    @relation("InvoiceSettlementAccount", fields: [settlementChartAccountId], references: [id], onDelete: SetNull)
  journalEntry             JournalEntry?      @relation("SalesInvoiceJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines                    SalesInvoiceLine[]
  payments                 Payment[]

  @@unique([businessId, publicCode])
  @@index([businessId, status])
}

model SalesInvoiceLine {
  id               String         @id @default(cuid())
  invoiceId        String
  chartOfAccountId String
  narration        String         @default("")
  quantity         Decimal        @db.Decimal(18, 6)
  unitLabel        String?
  unitAmount       Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  sortOrder        Int            @default(0)
  invoice          SalesInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

/**
 * Supplier / accounts-payable bill. General ledger posts only when status becomes PAID (cash-basis, money out).
 * Approving notifies the supplier contact by email when they have an email on file.
 */
model Bill {
  id                       String          @id @default(cuid())
  businessId               String
  contactId                String
  publicCode               String
  status                   BillStatus      @default(DRAFT)
  issueDate                DateTime
  dueDate                  DateTime?
  reference                String?
  currency                 String          @default("GMD")
  settlementChartAccountId String?
  journalEntryId           String?         @unique
  approvedAt               DateTime?
  paidAt                   DateTime?
  paymentGatewayCode       String?
  paymentProviderRef       String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  business                 Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact                  BusinessContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  settlementAccount        ChartOfAccount? @relation("BillSettlementAccount", fields: [settlementChartAccountId], references: [id], onDelete: SetNull)
  journalEntry             JournalEntry?   @relation("BillJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines                    BillLine[]
  payments                 Payment[]

  @@unique([businessId, publicCode])
  @@index([businessId, status])
}

model BillLine {
  id               String         @id @default(cuid())
  billId           String
  chartOfAccountId String
  narration        String         @default("")
  quantity         Decimal        @db.Decimal(18, 6)
  unitLabel        String?
  unitAmount       Decimal        @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  sortOrder        Int            @default(0)
  bill             Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([billId])
}

/**
 * Platform (EasyPay) chart — one global ledger, not per merchant Business.
 */
model PlatformChartOfAccount {
  id                       String                @id @default(cuid())
  code                     String                @unique
  name                     String
  description              String?               @db.Text
  category                 ChartAccountCategory
  kind                     ChartAccountKind      @default(LEDGER)
  bankAccountNumber        String?
  bankName                 String?
  bankDetails              String?               @db.Text
  isSystem                 Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  lines                    PlatformJournalLine[]
  platformBillLines        PlatformBillLine[]
  platformBillsSettledHere PlatformBill[]        @relation("PlatformBillSettlement")
  digitalOceanInvoicesSettledHere DigitalOceanInvoice[] @relation("DigitalOceanInvoiceSettlement")

  @@index([category])
}

model PlatformJournalEntry {
  id                             String                     @id @default(cuid())
  postedAt                       DateTime                   @default(now())
  memo                           String?
  sourceType                     PlatformJournalSourceType?
  sourceId                       String?
  reference                      String?
  /**
   * Merchant tenant when the entry is about a specific business (e.g. self-settlement).
   */
  businessId                     String?
  /**
   * When set, this entry reverses another platform journal (debits/credits swapped).
   * Each source journal can have at most one reversal row pointing to it.
   */
  reversesPlatformJournalEntryId String?                    @unique
  createdAt                      DateTime                   @default(now())
  lines                          PlatformJournalLine[]
  reversesPlatformJournalEntry   PlatformJournalEntry?      @relation("PlatformJournalReversal", fields: [reversesPlatformJournalEntryId], references: [id], onDelete: Restrict)
  reversedByPlatformEntry        PlatformJournalEntry?      @relation("PlatformJournalReversal")
  billFromPayment                PlatformBill?              @relation("PlatformBillJournal")
  digitalOceanInvoice            DigitalOceanInvoice?       @relation("DigitalOceanInvoiceJournal")
  business                       Business?                  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  waveSelfSettlementPayout       WaveSelfSettlementPayout?  @relation("WaveSelfSettlementJournal")

  @@index([postedAt])
  @@index([sourceType, sourceId])
  @@index([businessId])
}

model PlatformJournalLine {
  id               String                 @id @default(cuid())
  journalEntryId   String
  chartOfAccountId String
  debitAmount      Decimal                @default(0) @db.Decimal(12, 2)
  creditAmount     Decimal                @default(0) @db.Decimal(12, 2)
  description      String?                @db.Text
  quantity         Decimal?               @db.Decimal(18, 6)
  unitLabel        String?
  taxAmount        Decimal                @default(0) @db.Decimal(12, 2)
  journalEntry     PlatformJournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccount   PlatformChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([chartOfAccountId])
}

/**
 * Platform operator supplier / vendor (accounts payable contact).
 */
model PlatformSupplier {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bills          PlatformBill[]
  waveOpsPayouts WaveOpsPayout[]
}

/**
 * Platform purchase bill (pay suppliers). GL posts to platform chart when marked paid (cash basis), like merchant Bill.
 */
model PlatformBill {
  id                       String                  @id @default(cuid())
  supplierId               String
  publicCode               String                  @unique
  /**
   * Optional URL token for supplier-facing guest portal (view PDF / details without login).
   * Minted when the bill is approved and emailed.
   */
  guestToken               String?                 @unique
  status                   BillStatus              @default(DRAFT)
  issueDate                DateTime
  dueDate                  DateTime?
  reference                String?
  currency                 String                  @default("GMD")
  settlementChartAccountId String?
  platformJournalEntryId   String?                 @unique
  approvedAt               DateTime?
  paidAt                   DateTime?
  paymentGatewayCode       String?
  paymentProviderRef       String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  supplier                 PlatformSupplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  settlementAccount        PlatformChartOfAccount? @relation("PlatformBillSettlement", fields: [settlementChartAccountId], references: [id], onDelete: SetNull)
  journalEntry             PlatformJournalEntry?   @relation("PlatformBillJournal", fields: [platformJournalEntryId], references: [id], onDelete: SetNull)
  lines                    PlatformBillLine[]
  waveOpsPayouts           WaveOpsPayout[]
  digitalOceanInvoice      DigitalOceanInvoice?

  @@index([supplierId, status])
}

/**
 * Audit trail for platform Wave Operations payouts (wallet send to suppliers).
 */
model WaveOpsPayoutBatch {
  id             String          @id @default(cuid())
  waveBatchId    String?         @unique
  status         String          @default("processing")
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payouts        WaveOpsPayout[]

  @@index([createdAt])
}

model WaveOpsPayout {
  id                 String              @id @default(cuid())
  wavePayoutId       String?             @unique
  batchId            String?
  status             String              @default("processing")
  currency           String
  receiveAmount      String
  fee                String?
  mobile             String
  name               String
  clientReference    String?
  idempotencyKey     String              @unique
  platformSupplierId String?
  platformBillId     String?
  businessId         String?
  errorCode          String?
  errorMessage       String?             @db.Text
  waveTimestamp      DateTime?
  reversedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  batch              WaveOpsPayoutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  supplier           PlatformSupplier?   @relation(fields: [platformSupplierId], references: [id], onDelete: SetNull)
  bill               PlatformBill?       @relation(fields: [platformBillId], references: [id], onDelete: SetNull)
  business           Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  selfSettlementPayout WaveSelfSettlementPayout? @relation("WaveSelfSettlementOpsPayout")

  @@index([createdAt])
  @@index([status])
  @@index([platformSupplierId])
  @@index([clientReference])
  @@index([batchId])
  @@index([businessId])
}

model PlatformBillLine {
  id               String                 @id @default(cuid())
  billId           String
  chartOfAccountId String
  narration        String                 @default("")
  quantity         Decimal                @db.Decimal(18, 6)
  unitLabel        String?
  unitAmount       Decimal                @db.Decimal(12, 2)
  taxAmount        Decimal                @default(0) @db.Decimal(12, 2)
  sortOrder        Int                    @default(0)
  bill             PlatformBill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  chartOfAccount   PlatformChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@index([billId])
}

/**
 * Synced DigitalOcean invoice for platform-owner expense review and journal posting (USD stored; GMD posted).
 */
model DigitalOceanInvoice {
  id                       String                    @id @default(cuid())
  invoiceUuid              String                    @unique
  invoiceId                String
  billingPeriod            String
  amountUsd                Decimal                   @db.Decimal(12, 2)
  isPreview                Boolean                   @default(false)
  status                   DigitalOceanInvoiceStatus @default(SYNCED)
  summarySnapshot          Json?
  fxRateGmdPerUsd          Decimal?                  @db.Decimal(18, 6)
  amountGmd                Decimal?                  @db.Decimal(12, 2)
  settlementChartAccountId String?
  platformBillId           String?                   @unique
  platformJournalEntryId   String?                   @unique
  postedAt                 DateTime?
  postedByUserId           String?
  syncedAt                 DateTime                  @default(now())
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  settlementAccount        PlatformChartOfAccount?   @relation("DigitalOceanInvoiceSettlement", fields: [settlementChartAccountId], references: [id], onDelete: SetNull)
  platformBill             PlatformBill?             @relation(fields: [platformBillId], references: [id], onDelete: SetNull)
  platformJournalEntry     PlatformJournalEntry?     @relation("DigitalOceanInvoiceJournal", fields: [platformJournalEntryId], references: [id], onDelete: SetNull)
  postedBy                 User?                     @relation("DigitalOceanInvoicePostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([billingPeriod])
  @@index([syncedAt])
}

model SalesLedgerEntry {
  id                 String               @id @default(cuid())
  businessId         String
  orderId            String?
  paymentId          String?
  journalEntryId     String
  type               SalesLedgerEntryType
  direction          SalesLedgerDirection
  status             SalesLedgerStatus    @default(SUCCEEDED)
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @default("GMD")
  provider           String
  providerPaymentRef String?
  metadata           Json?
  succeededAt        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalEntry       JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  order              Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment            Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([paymentId, type])
  @@index([businessId, createdAt])
  @@index([orderId])
}

model MenuCategory {
  id         String         @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent     MenuCategory?  @relation("MenuCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   MenuCategory[] @relation("MenuCategoryHierarchy")
  products   Product[]

  @@index([businessId, parentId])
}

model DiningTable {
  id          String   @id @default(cuid())
  businessId  String
  label       String
  publicToken String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([businessId, publicToken])
  @@index([businessId])
}

/** Petrol (and similar): one merchant, many physical sites. Prices stay on Business / Product. */
model BusinessStation {
  id         String                @id @default(cuid())
  businessId String
  name       String
  code       String?
  address    String?
  isActive   Boolean               @default(true)
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pumps      BusinessStationPump[]
  orders     Order[]
  staffAssignments BusinessMembership[]

  @@index([businessId])
}

model BusinessStationPump {
  id        String          @id @default(cuid())
  stationId String
  label     String
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  station   BusinessStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([stationId, label])
  @@index([stationId])
}

model Product {
  id             String        @id @default(cuid())
  businessId     String
  name           String
  category       String
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  /**
   * Physical units on hand (not yet sold).
   */
  stock          Int           @default(0)
  /**
   * Units held for unpaid orders; released on cancel or applied on payment.
   */
  reservedStock  Int           @default(0)
  barcodeType    String        @default("CODE128")
  barcodeValue   String
  qrUrl          String
  imageUrl       String?
  imageColor     String        @default("bg-slate-100")
  imageEmoji     String        @default("")
  menuCategoryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuCategory   MenuCategory? @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  orderLines     OrderLine[]

  @@unique([businessId, barcodeValue])
  @@unique([businessId, qrUrl])
  @@index([businessId])
  @@index([menuCategoryId])
}

model User {
  id                                 String                         @id @default(cuid())
  name                               String
  email                              String                         @unique
  passwordHash                       String
  role                               UserRole                       @default(MERCHANT)
  isActive                           Boolean                        @default(true)
  mustChangePassword                 Boolean                        @default(false)
  passwordResetIssuedAt              DateTime?
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  platformFunctionGroupId            String?
  memberships                        BusinessMembership[]
  staffCreationNotificationLogs      StaffCreationNotificationLog[]
  businessSystemProducts             BusinessUserSystemProduct[]
  ordersCreated                      Order[]                        @relation("OrderCreatedBy")
  subscriptionInvoicesRefundReviewed SubscriptionInvoice[]          @relation("SubscriptionInvoiceRefundReviewedBy")
  platformFunctionGroup              PlatformFunctionGroup?         @relation(fields: [platformFunctionGroupId], references: [id], onDelete: SetNull)
  paymentsRecorded                   Payment[]                      @relation("PaymentRecordedBy")
  activityLogsAsActor                ActivityLog[]                  @relation("ActivityLogActor")
  journalEntriesApproved             JournalEntry[]                 @relation("JournalEntryApprovedBy")
  journalEntriesCancelled            JournalEntry[]                 @relation("JournalEntryCancelledBy")
  journalEntriesPostedAsPlatform     JournalEntry[]                 @relation("JournalEntryPostedByPlatform")
  ownerPushSubscriptions             BusinessOwnerPushSubscription[]
  digitalOceanInvoicesPosted         DigitalOceanInvoice[]          @relation("DigitalOceanInvoicePostedBy")

  @@index([platformFunctionGroupId])
}

model BusinessOwnerPushSubscription {
  id        String   @id @default(cuid())
  businessId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([businessId, userId])
  @@map("businessOwnerPushSubscriptions")
}

/**
 * Sidebar / platform feature identifiers for RBAC templates (seeded).
 */
model PlatformModule {
  id           String                           @id @default(cuid())
  slug         String                           @unique
  label        String
  sortOrder    Int                              @default(0)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  templateRows PlatformRoleTemplatePermission[]
}

/**
 * Named permission matrix (one row per module: view/create/edit/delete/export).
 */
model PlatformRoleTemplate {
  id             String                           @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  permissions    PlatformRoleTemplatePermission[]
  functionGroups PlatformFunctionGroup[]
}

model PlatformRoleTemplatePermission {
  id         String               @id @default(cuid())
  templateId String
  moduleId   String
  canView    Boolean              @default(false)
  canCreate  Boolean              @default(false)
  canEdit    Boolean              @default(false)
  canDelete  Boolean              @default(false)
  canExport  Boolean              @default(false)
  template   PlatformRoleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  module     PlatformModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([templateId, moduleId])
  @@index([moduleId])
}

/**
 * Bundles a role template; assigned to platform staff users.
 */
model PlatformFunctionGroup {
  id             String               @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  roleTemplateId String
  roleTemplate   PlatformRoleTemplate @relation(fields: [roleTemplateId], references: [id])
  users          User[]

  @@index([roleTemplateId])
}

model BusinessMembership {
  id         String                   @id @default(cuid())
  userId     String
  businessId String
  isOwner    Boolean                  @default(false)
  status     BusinessMembershipStatus @default(ACTIVE)
  /**
   * Petrol: optional branch assignment for staff. Null = may work any station (e.g. managers).
   */
  assignedStationId String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  user       User                     @relation(fields: [userId], references: [id])
  business   Business                 @relation(fields: [businessId], references: [id])
  assignedStation BusinessStation?    @relation(fields: [assignedStationId], references: [id], onDelete: SetNull)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@index([businessId, status])
  @@index([assignedStationId])
}

model SystemService {
  id          String          @id @default(cuid())
  name        String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  products    SystemProduct[]
}

model SystemProduct {
  id          String                      @id @default(cuid())
  serviceId   String
  name        String
  slug        String                      @unique
  description String?
  sortOrder   Int                         @default(0)
  /**
   * When set, product appears in the business sidebar under its service (must match app route path).
   */
  navPath     String?
  navLabel    String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  service     SystemService               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  planLinks   PlanSystemProduct[]
  userGrants  BusinessUserSystemProduct[]

  @@index([serviceId])
}

/**
 * Per-user assigned system products. Non-owners with no rows have no plan features until the owner assigns products.
 */
model BusinessUserSystemProduct {
  id              String        @id @default(cuid())
  businessId      String
  userId          String
  systemProductId String
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemProduct   SystemProduct @relation(fields: [systemProductId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, systemProductId])
  @@index([businessId, userId])
}

model PlanSystemProduct {
  id              String        @id @default(cuid())
  planId          String
  systemProductId String
  createdAt       DateTime      @default(now())
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  systemProduct   SystemProduct @relation(fields: [systemProductId], references: [id], onDelete: Cascade)

  @@unique([planId, systemProductId])
  @@index([planId])
  @@index([systemProductId])
}

model Plan {
  id                 String                @id @default(cuid())
  code               PlanCode              @unique
  name               String
  monthlyPrice       Decimal               @db.Decimal(10, 2)
  yearlyPrice        Decimal               @db.Decimal(10, 2)
  currency           String                @default("GMD")
  description        String
  staffLimit         Int
  outletLimit        Int
  productLimit       Int
  featureFlags       Json
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  subscriptions      Subscription[]
  invoices           SubscriptionInvoice[]
  planSystemProducts PlanSystemProduct[]
}

model Subscription {
  id                   String                @id @default(cuid())
  businessId           String
  planId               String
  billingInterval      BillingInterval       @default(MONTHLY)
  status               SubscriptionStatus    @default(ACTIVE)
  startDate            DateTime
  currentPeriodStart   DateTime
  /// Null when `contractPerpetual` (signed contract); no automatic renewal period.
  currentPeriodEnd     DateTime?
  /// `currentPeriodEnd` we already emailed a ~30-day-before ending reminder for.
  periodEndEarlyReminderSentFor DateTime?
  /// `currentPeriodEnd` we already emailed a ~7-day-before ending reminder for.
  periodEndReminderSentFor DateTime?
  /** Set when billing is CONTRACT_INFINITE and the contract invoice is satisfied. */
  contractPerpetual    Boolean               @default(false)
  cancelAtPeriodEnd    Boolean               @default(false)
  cancelledAt          DateTime?
  endedAt              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id])
  plan                 Plan                  @relation(fields: [planId], references: [id])
  invoices             SubscriptionInvoice[]
  billingLedgerEntries BillingLedgerEntry[]

  @@index([businessId, status])
  @@index([planId])
}

model SubscriptionInvoice {
  id                           String                   @id @default(cuid())
  businessId                   String
  subscriptionId               String
  planId                       String
  amount                       Decimal                  @db.Decimal(10, 2)
  currency                     String                   @default("GMD")
  status                       InvoiceStatus            @default(PENDING)
  billingPeriodStart           DateTime
  billingPeriodEnd             DateTime
  dueDate                      DateTime
  paidAt                       DateTime?
  externalReference            String?                  @unique
  /**
   * Last checkout session id (e.g. Wave) for webhook correlation.
   */
  checkoutSessionId            String?
  checkoutProvider             String?
  /**
   * Guest pay link (email) — same idea as sales invoice guest portal.
   */
  guestToken                   String?                  @unique
  manualRefundReviewStatus     ManualRefundReviewStatus @default(NONE)
  manualRefundNote             String?
  manualRefundReviewedAt       DateTime?
  manualRefundReviewedByUserId String?
  /**
   * Target date by which finance aims to complete the refund (set when status is APPROVED_FOR_REFUND).
   */
  manualRefundExpectedBy       DateTime?
  /**
   * Approved refund amount when partial; null means full invoice amount.
   */
  manualRefundApprovedAmount   Decimal?                 @db.Decimal(10, 2)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  business                     Business                 @relation(fields: [businessId], references: [id])
  subscription                 Subscription             @relation(fields: [subscriptionId], references: [id])
  plan                         Plan                     @relation(fields: [planId], references: [id])
  manualRefundReviewedBy       User?                    @relation("SubscriptionInvoiceRefundReviewedBy", fields: [manualRefundReviewedByUserId], references: [id], onDelete: SetNull)
  ledgerEntries                BillingLedgerEntry[]

  @@index([businessId, status])
  @@index([subscriptionId])
  @@index([checkoutSessionId])
  @@index([manualRefundReviewStatus])
}

model BillingLedgerEntry {
  id                        String                 @id @default(cuid())
  businessId                String
  subscriptionId            String?
  subscriptionInvoiceId     String?
  type                      BillingLedgerEntryType
  direction                 BillingLedgerDirection
  status                    BillingLedgerStatus    @default(PENDING)
  amount                    Decimal                @db.Decimal(10, 2)
  currency                  String                 @default("GMD")
  provider                  String
  /**
   * Shared by paired rows (invoice payment + wallet fee) for the same Wave/Yonna checkout.
   */
  providerCheckoutSessionId String?
  providerPaymentRef        String?
  idempotencyKey            String?                @unique
  metadata                  Json?
  succeededAt               DateTime?
  failedAt                  DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  business                  Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription              Subscription?          @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionInvoice       SubscriptionInvoice?   @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: SetNull)

  @@unique([providerCheckoutSessionId, type])
  @@index([businessId, createdAt])
  @@index([subscriptionInvoiceId])
  @@index([subscriptionId])
}

model StaffCreationNotificationLog {
  id               String                          @id @default(cuid())
  /**
   * Null when the notification is platform-scoped (e.g. platform admin invite).
   */
  businessId       String?
  userId           String?
  recipientName    String
  recipientEmail   String
  staffRole        UserRole
  notificationType StaffCreationNotificationType
  deliveryStatus   StaffCreationNotificationStatus @default(PENDING)
  provider         String                          @default("resend")
  subject          String
  htmlBody         String?
  textBody         String?
  resendEmailId    String?
  failureReason    String?
  sentAt           DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  business         Business?                       @relation(fields: [businessId], references: [id])
  user             User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
  @@map("staffCreationNotificationLogs")
}

model CorporateInvitationEmailLog {
  id                 String                          @id @default(cuid())
  organizationName   String
  contactName        String
  contactTitle       String?
  recipientEmail     String
  ccEmails           String[]                        @default([])
  senderName         String
  senderTitle        String?
  subject            String
  attachmentFilename String
  provider           String                          @default("resend")
  deliveryStatus     StaffCreationNotificationStatus @default(PENDING)
  resendEmailId      String?
  failureReason      String?
  sentAt             DateTime?
  createdByUserId    String?
  createdByName      String?
  createdByEmail     String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([createdAt])
  @@index([deliveryStatus])
  @@index([recipientEmail])
  @@map("corporateInvitationEmailLogs")
}

model Order {
  id                 String             @id @default(cuid())
  businessId         String
  publicCode         String
  status             OrderStatus        @default(PENDING_PAYMENT)
  subtotal           Decimal            @db.Decimal(10, 2)
  taxAmount          Decimal            @default(0) @db.Decimal(10, 2)
  total              Decimal            @db.Decimal(10, 2)
  currency           String             @default("GMD")
  createdByUserId    String?
  diningTableId      String?
  tableLabelSnapshot String?
  /** Petrol station: dispenser / pump identifier for this sale (required when industry is petrol). */
  pumpLabel          String?
  /** Petrol: which branch; pumpId references BusinessStationPump on this station. */
  stationId          String?
  pumpId             String?
  /**
   * Booking / checkout id from an internal partner app (server-to-server). Used for outbound webhooks.
   */
  partnerExternalBookingId String?
  /** Optional category label from internal partner at order creation (e.g. booking type). */
  partnerOrderCategory     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  diningTable        DiningTable?       @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  station            BusinessStation?   @relation(fields: [stationId], references: [id], onDelete: SetNull)
  pump               BusinessStationPump? @relation(fields: [pumpId], references: [id], onDelete: SetNull)
  lines              OrderLine[]
  payments           Payment[]
  receipt            Receipt?
  salesLedgerEntries SalesLedgerEntry[]

  @@unique([businessId, publicCode])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([diningTableId])
  @@index([businessId, partnerExternalBookingId])
  @@index([stationId])
  @@index([pumpId])
}

model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  /** Whole units (retail/restaurant) or liters for petrol (fractional). */
  quantity    Decimal @db.Decimal(18, 6)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id                 String             @id @default(cuid())
  businessId         String
  orderId            String?
  salesInvoiceId     String?            @unique
  billId             String?            @unique
  publicCode         String
  method             PaymentMethod
  provider           PaymentProvider    @default(SIMULATOR)
  /**
   * When set, identifies which business PaymentGateway credentials were used for QR wallet checkout.
   */
  gatewayCode        String?
  status             PaymentStatus      @default(PENDING)
  amount             Decimal            @db.Decimal(10, 2)
  currency           String             @default("GMD")
  providerRef        String             @unique
  publicToken        String             @unique
  completedAt        DateTime?
  /**
   * Staff member who recorded cash or initiated wallet checkout from POS (guest-paid wallet may still show this).
   */
  recordedByUserId   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  order              Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesInvoice       SalesInvoice?      @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  bill               Bill?              @relation(fields: [billId], references: [id], onDelete: Cascade)
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordedBy         User?              @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  salesLedgerEntries SalesLedgerEntry[]
  waveSelfSettlementPayout WaveSelfSettlementPayout?

  @@unique([businessId, publicCode])
  @@index([orderId])
  @@index([businessId, status])
  @@index([provider, status, completedAt])
  @@index([publicToken])
  @@index([recordedByUserId])
}

model ActivityLog {
  id           String            @id @default(cuid())
  /**
   * Null = platform-scoped event (operator actions outside a tenant).
   */
  businessId   String?
  actorUserId  String?
  actorKind    ActivityActorKind @default(USER)
  eventType    String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  business     Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorUser    User?             @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([createdAt])
}

model Receipt {
  id            String   @id @default(cuid())
  businessId    String
  orderId       String   @unique
  publicCode    String
  receiptNumber Int
  total         Decimal  @db.Decimal(10, 2)
  currency      String   @default("GMD")
  linesSnapshot Json
  paymentMethod String
  provider      String   @default("SIMULATOR")
  providerRef   String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptNumber])
  @@unique([businessId, publicCode])
}

model WebhookEventLog {
  id        String   @id @default(cuid())
  provider  String
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([provider, eventKey])
}
